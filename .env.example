# Copy to .env and fill in your values. For local development start Postgres first:
#   docker compose up -d --wait

# ── LLM provider (any OpenAI-compatible endpoint; defaults to DeepSeek) ──
LLM_API_KEY=your-deepseek-api-key-here
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
MAX_TOKENS=2000
LOG_LEVEL=INFO

# ── Database (local default: the docker-compose Postgres on host port 5433) ──
DATABASE_URL=postgresql+psycopg2://trpg:trpg@localhost:5433/trpg

# ── Auth ──
# Use a real random value of 32+ bytes in any deployed environment.
JWT_SECRET=dev-insecure-secret-change-in-production-please
JWT_TTL_DAYS=7
# On the very first start with an empty users table, these create the initial admin
# (never re-seeded afterwards). Leave the password empty to skip.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
