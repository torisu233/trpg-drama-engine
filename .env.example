# 复制成 .env 并填入你的值。本机开发先：docker compose up -d --wait 起 Postgres。

# ── LLM 服务端（OpenAI 兼容；现用 DeepSeek。env 名沿用 GROK_*）──
GROK_API_KEY=your-deepseek-api-key-here          # DeepSeek 平台申请的 sk-...
GROK_API_BASE_URL=https://api.deepseek.com
GROK_MODEL=deepseek-chat                          # DeepSeek V4 Flash(非思考)；2026/07/24 后改 deepseek-v4-flash
MAX_TOKENS=2000
LOG_LEVEL=INFO

# ── 数据库（本机默认连 docker-compose 的 PG:5433；云端设为 RDS）──
DATABASE_URL=postgresql+psycopg2://trpg:trpg@localhost:5433/trpg

# ── Auth ──
JWT_SECRET=dev-insecure-secret-change-in-production-please   # 云端务必换成真随机值(≥32字节)
JWT_TTL_DAYS=7
# 空库首次启动用这组创建初始管理员（之后有用户即不再 seed）。本机想要 admin 就填上密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
