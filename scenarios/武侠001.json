{
  "id": "武侠001",
  "世界观": {
    "基调": "武侠。江湖恩怨、刀光剑影，重义轻生死，市井与庙堂交错。",
    "背景": "这是个武林门派林立的年代。漕帮把持运河命脉，黑白通吃；江湖人讲的是面子、义气与恩仇。武功分高下：练到家的高手气劲护体，寻常兵刃难伤分毫，唯有更高明的手段才动得了他。钱与命，在江湖上常常等价。",
    "法则": [
      "武功大成者运气护体，寻常刀剑拳脚难伤其要害；须以更强内力、毒、火攻、点中要穴、出其不意攻其弱点，或断其根基（废其武功来源）方能制之。",
      "轻功高者可飞檐走壁、瞬间欺近或脱身；轻功低者追之不及。",
      "内伤重于外伤，且难以速愈；中毒、点穴会在数招内逐步发作。",
      "以势压人有时胜过动手：威望、把柄、人质可不战而屈人之兵。"
    ]
  },
  "scene": {
    "id": "tavern",
    "地点": "雨夜酒馆，炉火将熄，后门通向马厩",
    "钩子": "刀疤一手按在刀柄上，慢悠悠开口：「听说你欠漕帮的钱，今晚想怎么还？」",
    "在场": [
      "player",
      "aqing",
      "scar"
    ]
  },
