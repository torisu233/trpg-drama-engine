# Keep the build context small and keep things out of the image that don't belong there.
# (.dockerignore only supports full-line comments.)
.git
.github
.venv
**/__pycache__
**/*.pyc
**/node_modules
# Rebuilt inside the container; never ship a stale host build
frontend/dist
# Legacy JSON save directory (data now lives in the DB)
data
# Secrets are injected at runtime, never baked into the image
.env
.coverage
.pytest_cache
# Tests run in CI, not in the production image
tests
docs
*.ps1
.claude
